APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
BACKEND_URL=http://127.0.0.1:8000
# Server-to-server secret, same on backend and frontend; at least 32 random characters.
BACKEND_GATEWAY_TOKEN=
# Legacy rollback only; unused in Clerk mode. Never use a NEXT_PUBLIC_ secret.
SESSION_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Configure the provider to issue RS256 access JWTs for the backend audience,
# with UUID subjects. Add required API scope(s) to this provider-managed value.
OIDC_SCOPE=openid
# Set only if your provider requires these authorization parameters.
OIDC_RESOURCE=
OIDC_AUDIENCE=
