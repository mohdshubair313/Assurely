# PRIVATE runtime file template. Values below are placeholders, never real credentials.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://SERVICE_USER:REPLACE_PASSWORD@db.example.com/assurely?ssl=verify-full
REDIS_URL=rediss://SERVICE_USER:REPLACE_PASSWORD@redis.example.com:6379/0
# Private Chroma service only; never publish its API on a public interface.
CHROMA_HOST=chroma.private.example.com
CHROMA_PORT=8000
AUTH_PROVIDER=clerk
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_AUTHORIZED_PARTIES=["https://assurely.shubair.in"]
ADMIN_SUBJECTS=[]
AUTH_TEST_SUBJECTS=[]
BACKEND_GATEWAY_TOKEN=
POLICY_REVIEWER_SUBJECTS=[]
POLICY_PUBLISHER_SUBJECTS=[]
ADVISOR_SUBJECTS=[]
ADVISOR_WEBHOOK_URL=
ADVISOR_WEBHOOK_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CORS_ORIGINS=[]
