# Set in Vercel > project > Settings > Environment Variables, Production scope.
APP_ORIGIN=https://assurely.shubair.in
# Use the real HTTPS URL after backend staging is healthy.
BACKEND_URL=https://REPLACE_BACKEND_HOST
# Same random 32+ character secret as backend; never prefix with NEXT_PUBLIC_.
BACKEND_GATEWAY_TOKEN=
# Legacy rollback only: independent 32-byte base64 key for encrypted sessions.
SESSION_SECRET=
NEXT_PUBLIC_AUTH_PROVIDER=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# OIDC values below are retained only for an explicit legacy_oidc rollback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid
OIDC_RESOURCE=
OIDC_AUDIENCE=
