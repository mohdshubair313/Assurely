# Compose interpolation only. Actual secrets go in private runtime files/secret storage.
PUBLIC_HOST=insurance.example.com
BIND_ADDRESS=127.0.0.1
API_IMAGE=assurely-api:release
FRONTEND_IMAGE=assurely-frontend:release
BACKEND_ENV_FILE=/secure/assurely/backend.env
FRONTEND_ENV_FILE=/secure/assurely/frontend.env
TLS_CERT_FILE=/secure/assurely/fullchain.pem
TLS_KEY_FILE=/secure/assurely/privkey.pem
