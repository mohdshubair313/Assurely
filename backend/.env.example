# Local development only. Copy to .env; never commit credentials.
ENVIRONMENT=development
TUNNEL_INGRESS_ONLY=false
LOG_LEVEL=info
DATABASE_URL=postgresql+asyncpg://insurance:insurance_dev@localhost:5432/insurance_db
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8100

# Optional for deterministic tests; needed for live model-backed workflows.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Trusted RS256 identity provider and independent operator allowlists.
AUTH_PROVIDER=clerk
CLERK_PUBLISHABLE_KEY=
# Needed for Clerk account-management calls; JWT verification uses public JWKS.
CLERK_SECRET_KEY=
AUTH_ISSUER=
# Leave audience empty for standard Clerk v2 session tokens.
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_AUTHORIZED_PARTIES=["http://localhost:3000"]
ADMIN_SUBJECTS=[]
AUTH_TEST_SUBJECTS=[]
POLICY_REVIEWER_SUBJECTS=[]
POLICY_PUBLISHER_SUBJECTS=[]
ADVISOR_SUBJECTS=[]

# Optional observability and independently operated notification receiver.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
ADVISOR_WEBHOOK_URL=
ADVISOR_WEBHOOK_TOKEN=

# Voice feature stays closed until an approved billing/provider rollout.
VOICE_PROVIDER=disabled
# Customer request receipts require migration 015 and a durable Clerk staging rollout.
# Turning this off blocks new requests; existing requests still require fresh human review.
HUMAN_REVIEW_REQUESTS_ENABLED=false
VOICE_RECOVERY_INTERVAL_SECONDS=5
VOICE_TEST_SUBJECTS=[]
VOICE_TEST_ALLOWANCE_MINUTES=15
VOICE_MAX_CALL_SECONDS=300
VOICE_MAX_CONCURRENT_CALLS=1
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_WEBHOOK_SECRET=
VAANI_BYOL_TOKEN=
VAANI_STAGING_BASE_URL=
VOICE_DEVELOPMENT_ENABLED=false
VOICE_TOOLS_ENABLED=false
VOICE_CASE_BINDING_ENABLED=false
# Explicit fictional staging report-read bridge; requires migration 017 and release checks.
VOICE_BYOL_EVIDENCE_ENABLED=false
VOICE_BILLING_TEST_ENABLED=false
VOICE_FUNDED_TEST_ENABLED=false
# Fernet key configured privately; never a NEXT_PUBLIC variable.
VOICE_TOKEN_ENCRYPTION_KEY=
VOICE_SUMMARY_RETENTION_HOURS=24
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
VOICE_TEST_PLAN_ID=
VOICE_TEST_PLAN_SECONDS=0
# V2a: leave these false until the corresponding deployment gate is reviewed.
VAANI_DISPATCH_ENABLED=false
VAANI_INGRESS_ENABLED=false
VAANI_BYOL_ENABLED=false
VAANI_DEV_AGENT_REVIEWED=false
