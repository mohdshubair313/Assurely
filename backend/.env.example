# Local development only. Copy to .env; never commit credentials.
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=postgresql+asyncpg://insurance:insurance_dev@localhost:5432/insurance_db
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8100

# Optional for deterministic tests; needed for live model-backed workflows.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Trusted RS256 identity provider and independent operator allowlists.
AUTH_PROVIDER=clerk
CLERK_PUBLISHABLE_KEY=
# Needed for Clerk account-management calls; JWT verification uses public JWKS.
CLERK_SECRET_KEY=
AUTH_ISSUER=
# Leave audience empty for standard Clerk v2 session tokens.
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_AUTHORIZED_PARTIES=["http://localhost:3000"]
ADMIN_SUBJECTS=[]
AUTH_TEST_SUBJECTS=[]
POLICY_REVIEWER_SUBJECTS=[]
POLICY_PUBLISHER_SUBJECTS=[]
ADVISOR_SUBJECTS=[]

# Optional observability and independently operated notification receiver.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
ADVISOR_WEBHOOK_URL=
ADVISOR_WEBHOOK_TOKEN=
