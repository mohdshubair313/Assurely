# Local development only. Copy to .env; never commit credentials.
ENVIRONMENT=development
LOG_LEVEL=info
DATABASE_URL=postgresql+asyncpg://insurance:insurance_dev@localhost:5432/insurance_db
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8100

# Optional for deterministic tests; needed for live model-backed workflows.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Trusted RS256 identity provider and independent operator allowlists.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
POLICY_REVIEWER_SUBJECTS=[]
POLICY_PUBLISHER_SUBJECTS=[]
ADVISOR_SUBJECTS=[]

# Optional observability and independently operated notification receiver.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
ADVISOR_WEBHOOK_URL=
ADVISOR_WEBHOOK_TOKEN=
